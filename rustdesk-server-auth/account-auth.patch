@@ -0,0 +1,101 @@
+use crate::common::get_arg;
+use hbb_common::{
+    anyhow::{anyhow, Context},
+    log, timeout, ResultType,
+};
+use serde_derive::{Deserialize, Serialize};
+
+const AUTH_TIMEOUT: u64 = 3_000;
+
+#[derive(Serialize)]
+struct AuthorizationRequest<'a> {
+    token: &'a str,
+    target_id: &'a str,
+}
+
+#[derive(Deserialize)]
+struct AuthorizationResponse {
+    allowed: bool,
+    reason: Option<String>,
+}
+
+#[derive(Clone)]
+pub struct AccountAuth {
+    client: reqwest::Client,
+    url: String,
+    secret: String,
+    allow_anonymous: bool,
+}
+
+impl AccountAuth {
+    pub fn from_env() -> ResultType<Self> {
+        Ok(Self {
+            client: reqwest::Client::builder().no_proxy().build()?,
+            url: get_arg("rendezvous-auth-url"),
+            secret: get_arg("rendezvous-auth-secret"),
+            allow_anonymous: matches!(
+                get_arg("rendezvous-allow-anonymous")
+                    .to_ascii_lowercase()
+                    .as_str(),
+                "1" | "true" | "y" | "yes"
+            ),
+        })
+    }
+
+    pub async fn authorize(&self, token: &str, target_id: &str) -> Result<(), String> {
+        if token.is_empty() {
+            return if self.allow_anonymous {
+                Ok(())
+            } else {
+                Err("Account login is required".to_owned())
+            };
+        }
+        self.authorize_account(token, target_id)
+            .await
+            .map_err(|err| {
+                log::warn!(
+                    "Account authorization failed for target {}: {}",
+                    target_id,
+                    err
+                );
+                "Account authorization service is unavailable".to_owned()
+            })?
+    }
+
+    async fn authorize_account(
+        &self,
+        token: &str,
+        target_id: &str,
+    ) -> ResultType<Result<(), String>> {
+        if self.url.is_empty() || self.secret.is_empty() {
+            return Err(anyhow!("account authorization is not configured"));
+        }
+        let response = timeout(
+            AUTH_TIMEOUT,
+            self.client
+                .post(&self.url)
+                .bearer_auth(&self.secret)
+                .json(&AuthorizationRequest { token, target_id })
+                .send(),
+        )
+        .await
+        .context("account authorization timed out")??;
+        if !response.status().is_success() {
+            return Err(anyhow!(
+                "account authorization returned {}",
+                response.status()
+            ));
+        }
+        let response = response
+            .json::<AuthorizationResponse>()
+            .await
+            .context("invalid account authorization response")?;
+        if response.allowed {
+            Ok(Ok(()))
+        } else {
+            Ok(Err(response
+                .reason
+                .unwrap_or_else(|| "Account access denied".to_owned())))
+        }
+    }
+}
